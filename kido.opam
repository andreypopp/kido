# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A workflow on top of tmux to manage coding agents"
homepage: "https://github.com/andreypopp/kido"
bug-reports: "https://github.com/andreypopp/kido/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.5"}
  "containers" {>= "3.18"}
  "cmdliner" {>= "2.1"}
  "yojson" {>= "3.0"}
  "ppx_deriving_yojson" {>= "3.10"}
  "mtime" {>= "2.2"}
  "mosaic"
  "ppx_expect" {with-test}
  "ocamlformat" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/andreypopp/kido.git"
pin-depends: [
  ["mosaic.dev" "git+https://github.com/invariant-hq/mosaic#0ef02a5690365f8f7518c54755287f905814529f"]
  ["matrix.dev" "git+https://github.com/invariant-hq/mosaic#0ef02a5690365f8f7518c54755287f905814529f"]
  ["toffee.dev" "git+https://github.com/invariant-hq/mosaic#0ef02a5690365f8f7518c54755287f905814529f"]
  ["tree-sitter.dev" "git+https://github.com/invariant-hq/mosaic#0ef02a5690365f8f7518c54755287f905814529f"]
]
