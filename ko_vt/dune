(rule
 (targets cxx_flags.sexp)
 (deps cxx.sh)
 (action
  (with-stdout-to
   cxx_flags.sexp
   (run sh -c "printf '(%s)\\n' \"$(sh cxx.sh)\""))))

(rule
 (targets ghostty.terminfo)
 (deps
  terminfo.zig
  (source_tree ../third_party/ghostty/src/terminfo))
 (action
  (with-stdout-to
   ghostty.terminfo
   (run
    zig
    run
    -lc
    --dep
    terminfo
    -Mroot=terminfo.zig
    -Mterminfo=../third_party/ghostty/src/terminfo/main.zig))))

(rule
 (targets xterm-ghostty)
 (deps ghostty.terminfo)
 (action
  (progn
   (run tic -x -o terminfo ghostty.terminfo)
   (run
    sh
    -c
    "cp terminfo/x/xterm-ghostty xterm-ghostty 2>/dev/null || cp terminfo/78/xterm-ghostty xterm-ghostty"))))

(install
 (section share_root)
 (files
  (xterm-ghostty as ko/terminfo/x/xterm-ghostty)))

(rule
 (targets libghostty-vt.a)
 (deps
  (source_tree ../third_party/ghostty))
 (action
  (setenv
   ZIG_GLOBAL_CACHE_DIR
   .zig-global-cache
   (progn
    (run
     zig
     build
     --build-file
     ../third_party/ghostty/build.zig
     -Demit-lib-vt
     -Demit-xcframework=false
     -Doptimize=ReleaseFast
     --cache-dir
     .zig-cache
     --prefix
     zig-out)
    (run cp zig-out/lib/libghostty-vt.a libghostty-vt.a)))))

(executable
 (name decode)
 (modules decode)
 (flags
  (:standard -open Containers))
 (libraries ko_vt yojson))

(library
 (name ko_vt)
 (modules ko_vt)
 (flags
  (:standard -open Containers))
 (libraries containers)
 (foreign_stubs
  (language c)
  (names ko_vt_stubs)
  (extra_deps ../ko_pane/snapshot_cut.h ../ko_pane/buffer.h)
  (flags
   (:standard -I../third_party/ghostty/include -I../ko_pane)))
 (c_library_flags
  (:standard
   (:include cxx_flags.sexp)))
 (foreign_archives ghostty-vt)
 (inline_tests)
 (preprocess
  (pps ppx_expect)))
