---
import { media } from '../lib/site';
const { name, label } = Astro.props;
const files = media[name];
const mobile = files.mobile;
---
<figure class="demo reveal">
  <div class="demo-screen">
    <picture>
      <source media="(max-width:700px)" srcset={mobile.poster} />
      <img src={files.poster} alt={label} width="1920" height="1152" loading="lazy" />
    </picture>
    <video muted loop playsinline preload="none" poster={files.poster} data-desktop-poster={files.poster} data-mobile-poster={mobile.poster} aria-label={label}>
      <source media="(max-width:700px)" src={mobile.webm} type="video/webm" />
      <source media="(max-width:700px)" src={mobile.mp4} type="video/mp4" />
      <source src={files.webm} type="video/webm" />
      <source src={files.mp4} type="video/mp4" />
    </video>
    <button class="video-toggle" type="button" aria-label="Pause video">Pause</button>
  </div>
</figure>
<script>
  const mobileQuery = window.matchMedia('(max-width:700px)');
  document.querySelectorAll<HTMLVideoElement>('video[data-mobile-poster]').forEach((video) => {
    const updatePoster = () => { video.poster = (mobileQuery.matches ? video.dataset.mobilePoster : video.dataset.desktopPoster)!; };
    updatePoster();
    mobileQuery.addEventListener('change', updatePoster);
  });
</script>
