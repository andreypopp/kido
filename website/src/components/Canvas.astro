---
import { checks, planet, taper, target } from '../lib/art';
export const height = 3680;
const X1 = [40, 1034.5], X2 = [1371, 2417], X3 = [92.5, 2903], END = [720, 3330];
const art = `
<g fill="none" stroke="var(--line)" stroke-width="1.5"><path d="M700 850 1900 1093"/><path d="M-460 1527 520 1640"/><path d="M1900 1990 980 2290"/><path d="M-460 2614 520 2840"/></g>
${taper([262.5, 815], [20, 1054], 10, 3)}
${taper(X1, [1440, 2488.7], 3, 8)}
<use href="#hero-art" x="130" y="50" width="1100" height="830"/>
<circle cx="${X1[0]}" cy="${X1[1]}" r="32" fill="none" stroke="var(--line)" stroke-width="2"/><circle cx="${X1[0]}" cy="${X1[1]}" r="15" fill="var(--yellow)"/>
${checks(1180, 860, -18)}

${taper([1440, 2390.8], [0, 2938.2], 8, 3)}
${taper([0, 2840], END, 3, 8)}
<path d="M1105 1034 1325 994 1365 1214 1145 1254Z" fill="var(--red)"/>
<path d="M824 1124 1298 1102 1288 1432 838 1422Z" fill="var(--plane)"/>
<g stroke="var(--ink)" stroke-width="9"><path d="M1246 1490 1336 1454M1252 1520 1338 1484M1258 1550 1340 1514"/></g>
<circle cx="640" cy="1590" r="14" fill="var(--green)"/>

<circle cx="235" cy="1765" r="130" fill="var(--blue)"/><circle cx="185" cy="1700" r="12" fill="var(--yellow)"/><circle cx="290" cy="1688" r="9" fill="var(--paper)"/>
<path d="M168 1738 654 1714 642 2082 184 2068Z" fill="var(--plane)"/>
${target(630, 2570, 0.8)}

<circle cx="${X2[0]}" cy="${X2[1]}" r="30" fill="var(--orange)"/>
<path d="M1400 2372 1342 2462" stroke="var(--ink)" stroke-width="11"/><path d="M1396 2378 1346 2456" stroke="var(--paper)" stroke-width="4" stroke-dasharray="5 7"/>
<path d="M1100 2460 1270 2770 930 2770Z" fill="var(--yellow)"/>
<circle cx="1250" cy="2600" r="20" fill="var(--red)"/>
<path d="M736 2262 1186 2240 1176 2552 750 2542Z" fill="var(--plane)"/>
${checks(250, 2640, 14)}
${planet(X3[0], X3[1], 36)}
<circle cx="1330" cy="3180" r="22" fill="var(--yellow)"/><circle cx="1330" cy="3180" r="36" fill="none" stroke="var(--line)" stroke-width="2"/>
<circle cx="720" cy="4330" r="1000" fill="var(--ink)"/>
<circle cx="${END[0]}" cy="${END[1]}" r="32" fill="var(--orange)"/>
`;
---
<svg class="canvas" viewBox={`0 0 1440 ${height}`} aria-hidden="true" set:html={art} />
<svg class="canvas flat" viewBox={`0 0 1440 ${height}`} aria-hidden="true">
  <path d="M210 600 420 500 470 590 300 770Z" fill="var(--brown)"/>
  <path d="M380 2900 570 2840 610 2980 430 3030Z" fill="var(--brown)"/>
</svg>
