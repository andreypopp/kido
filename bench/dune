(executable
 (name coordinator)
 (modules coordinator)
 (flags
  (:standard -open Containers))
 (libraries containers unix luv ko_vt ko_server bigstringaf)
 (foreign_stubs
  (language c)
  (names measure_stubs)
  (extra_deps ../ko_pane/now.h cpu.h)))

(rule
 (targets wait_master.exe)
 (deps wait_master.c)
 (action
  (run
   cc
   -std=c11
   -O2
   -Wall
   -Wextra
   -Werror
   wait_master.c
   -o
   wait_master.exe)))

