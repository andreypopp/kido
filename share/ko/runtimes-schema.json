{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtimes",
  "description": "The runtime configuration file: the runtimes that panes can run in, by name.",
  "type": "object",
  "properties": {
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9-]{1,32}$": {
          "$ref": "#/$defs/Runtime"
        }
      }
    }
  },
  "required": [
    "runtimes"
  ],
  "$defs": {
    "AbsPath": {
      "description": "An absolute path.",
      "type": "string",
      "pattern": "^/"
    },
    "Access": {
      "type": "string",
      "enum": [
        "ro"
      ]
    },
    "Command": {
      "type": "object",
      "properties": {
        "lead": {
          "description": "An interactive step of the start. One waiting pane runs it on its own terminal and\nreports the result.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "prefix": {
          "description": "The argv that goes before `ko enter` in a pane's program.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "socket": {
          "description": "Where the runtime's socket is reached inside the runtime. Default: the host path.",
          "anyOf": [
            {
              "$ref": "#/$defs/AbsPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "up": {
          "description": "A step of the start that the server runs as its own child. Exit 0 continues the start.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Container": {
      "type": "object",
      "properties": {
        "container": {
          "description": "The `container` program. Default: `container` on the PATH of the server.",
          "anyOf": [
            {
              "$ref": "#/$defs/Program"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "$ref": "#/$defs/Source"
        },
        "init": {
          "description": "The command that keeps the container alive.",
          "type": "array",
          "default": [
            "sleep",
            "infinity"
          ],
          "items": {
            "type": "string"
          }
        },
        "ko": {
          "$ref": "#/$defs/Ko",
          "default": "shipped"
        },
        "run_args": {
          "description": "More arguments of `container run`. ko refuses the options it owns.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "ssh_agent": {
          "$ref": "#/$defs/SshAgent",
          "default": "none"
        },
        "user": {
          "description": "The user of every exec, as `container exec -u` takes it. Default: the image's.",
          "anyOf": [
            {
              "$ref": "#/$defs/User"
            },
            {
              "type": "null"
            }
          ]
        },
        "volumes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Volume"
          }
        }
      },
      "required": [
        "from"
      ]
    },
    "Ko": {
      "oneOf": [
        {
          "description": "The static Linux ko beside the server's installation, mounted read-only at /opt/ko.",
          "type": "string",
          "const": "shipped"
        },
        {
          "description": "The `ko` on the PATH of the image.",
          "type": "string",
          "const": "path"
        },
        {
          "description": "Another installed layout, mounted read-only at /opt/ko.",
          "type": "object",
          "properties": {
            "mount": {
              "$ref": "#/$defs/AbsPath"
            }
          },
          "additionalProperties": false,
          "required": [
            "mount"
          ]
        }
      ]
    },
    "Operand": {
      "description": "an image reference or a container name",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]*$"
    },
    "PathMap": {
      "description": "A directory of the host and the directory of the runtime that holds the same files.",
      "type": "object",
      "properties": {
        "host": {
          "$ref": "#/$defs/AbsPath"
        },
        "runtime": {
          "$ref": "#/$defs/AbsPath"
        }
      },
      "required": [
        "host",
        "runtime"
      ]
    },
    "Program": {
      "description": "a program name or path",
      "type": "string",
      "pattern": "^[^\\u0000]+$"
    },
    "Runtime": {
      "type": "object",
      "properties": {
        "cwd": {
          "description": "The directory inside the runtime for a pane whose request names none that maps.",
          "anyOf": [
            {
              "$ref": "#/$defs/AbsPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "env": {
          "description": "Variables for every pane of the runtime, applied before the variables of the request.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "paths": {
          "description": "A host directory that a host caller names as cwd maps to the runtime directory of the\nlongest matching host prefix.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PathMap"
          }
        }
      },
      "oneOf": [
        {
          "description": "A runtime on an ssh host, reached through one ssh master that the first pane logs in.\nko must be installed there, on the PATH of ssh commands.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ssh"
            }
          },
          "$ref": "#/$defs/Ssh",
          "required": [
            "kind"
          ]
        },
        {
          "description": "A runtime on the host, for the tests of the link machinery. The server accepts it only\nwith KO_RUNTIME_COMMAND_KIND=1 in its environment.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "command"
            }
          },
          "$ref": "#/$defs/Command",
          "required": [
            "kind"
          ]
        },
        {
          "description": "A container of Apple's `container`, which ko creates from an image or finds by name.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "container"
            }
          },
          "$ref": "#/$defs/Container",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Source": {
      "oneOf": [
        {
          "description": "A container that ko creates from the image and owns: down stops it and DELETE removes it.",
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/$defs/Operand"
            }
          },
          "additionalProperties": false,
          "required": [
            "image"
          ]
        },
        {
          "description": "A container that the user created with `-v <runtime socket>:/run/ko/socket` and manages.",
          "type": "object",
          "properties": {
            "container": {
              "$ref": "#/$defs/Operand"
            }
          },
          "additionalProperties": false,
          "required": [
            "container"
          ]
        }
      ]
    },
    "Ssh": {
      "type": "object",
      "properties": {
        "destination": {
          "description": "The ssh destination as typed: `host` or `user@host`.",
          "type": "string"
        },
        "dir": {
          "description": "The directory on the remote for the forwarded socket and the token files. Default:\n`$XDG_RUNTIME_DIR/ko-rt/NAME`, else `/tmp/ko-rt-UID/NAME`.",
          "anyOf": [
            {
              "$ref": "#/$defs/AbsPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "ssh_args": {
          "description": "Connection options for the master (`-p`, `-J`, `-F`, `-i`, `-l`, `-o`, ...).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "destination"
      ]
    },
    "SshAgent": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "description": "The host's agent at /var/host-services/ssh-auth.sock (`--ssh`).",
          "type": "string",
          "const": "forward"
        }
      ]
    },
    "User": {
      "description": "a user name or id",
      "type": "string",
      "pattern": "^[^-\\u0000][^\\u0000]*$"
    },
    "Volume": {
      "description": "A directory of the host that the container mounts, files only: never a socket.",
      "type": "object",
      "properties": {
        "host": {
          "$ref": "#/$defs/AbsPath"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/Access"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime": {
          "$ref": "#/$defs/AbsPath"
        }
      },
      "required": [
        "host",
        "runtime"
      ]
    }
  }
}
