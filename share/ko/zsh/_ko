#compdef ko
local _CLAP_COMPLETE_INDEX=$((CURRENT - 1))
local _CLAP_IFS=$'\n'
local -a completions=("${(@f)$(
  _CLAP_IFS="$_CLAP_IFS" \
  _CLAP_COMPLETE_INDEX="$_CLAP_COMPLETE_INDEX" \
  COMPLETE=zsh \
  ko -- "${words[@]}" </dev/null 2>/dev/null
)}")
if [[ -n $completions ]]; then
  local -a dirs=() other=()
  local completion value dir_no_slash desc
  for completion in $completions; do
    value="${completion%%:*}"
    if [[ $value == */ ]]; then
      dir_no_slash="${value%/}"
      if [[ $completion == *:* ]]; then
        desc="${completion#*:}"
        dirs+=("$dir_no_slash:$desc")
      else
        dirs+=("$dir_no_slash")
      fi
    else
      other+=("$completion")
    fi
  done
  [[ -n $dirs ]] && _describe -V values dirs -S / -r /
  [[ -n $other ]] && _describe -V values other
fi
