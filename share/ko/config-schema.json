{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "The ko configuration file, `config.yaml`.",
  "type": "object",
  "properties": {
    "app": {
      "description": "The settings of Kido.app.",
      "$ref": "#/$defs/App",
      "default": {
        "clipboard": {
          "copy_on_select": false,
          "paste_protection": true,
          "read": "ask",
          "trim_trailing_spaces": true,
          "write": "allow"
        },
        "font": {
          "features": [],
          "line_height": 0.0,
          "size": 13.0,
          "thicken": false
        },
        "keyboard": {
          "option_as_alt": "off"
        },
        "keys": {},
        "mouse": {
          "hide_while_typing": false,
          "scroll_multiplier": {
            "discrete": 3.0,
            "precision": 1.0
          }
        },
        "theme": {
          "dark": "kido-dark",
          "light": "kido-light"
        },
        "window": {
          "sidebar_shade": 5.0,
          "unfocused_shift": 3.0
        }
      }
    },
    "runtimes": {
      "description": "The runtimes that panes can run in, by name.",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^[a-z0-9-]{1,32}$": {
          "$ref": "#/$defs/Runtime"
        }
      }
    },
    "server": {
      "description": "The settings of ko server.",
      "$ref": "#/$defs/Server",
      "default": {
        "kitty_images_max_bytes": 10000000,
        "linger_seconds": 30.0,
        "runtime_idle_seconds": 600.0,
        "scrollback": {
          "bytes": 50000000,
          "lines": "unlimited"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AbsPath": {
      "description": "an absolute path",
      "type": "string",
      "pattern": "^/"
    },
    "Access": {
      "type": "string",
      "enum": [
        "ro"
      ]
    },
    "Action": {
      "description": "unbind, paste_from_clipboard, copy_to_clipboard, reset_font_size, increase_font_size:POINTS, decrease_font_size:POINTS (0.1 to 72), or text:, csi: or esc: and the text to send, with Ghostty's escapes such as \\x1b. The text has no control character and no space at either end.",
      "type": "string",
      "pattern": "^(unbind|paste_from_clipboard|copy_to_clipboard|reset_font_size|(text|csi|esc):[^\\u0000-\\u001f\\u007f ]([^\\u0000-\\u001f\\u007f]*[^\\u0000-\\u001f\\u007f ])?|(increase|decrease)_font_size:[0-9.]+)$"
    },
    "App": {
      "description": "Kido.app's settings.",
      "type": "object",
      "properties": {
        "clipboard": {
          "$ref": "#/$defs/Clipboard",
          "default": {
            "copy_on_select": false,
            "paste_protection": true,
            "read": "ask",
            "trim_trailing_spaces": true,
            "write": "allow"
          }
        },
        "font": {
          "$ref": "#/$defs/Font",
          "default": {
            "features": [],
            "line_height": 0.0,
            "size": 13.0,
            "thicken": false
          }
        },
        "keyboard": {
          "$ref": "#/$defs/Keyboard",
          "default": {
            "option_as_alt": "off"
          }
        },
        "keys": {
          "description": "Extra key bindings, by trigger.",
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^((super|cmd|command|ctrl|control|alt|opt|option|shift)\\+)*(\\+|[^+]+)$": {
              "$ref": "#/$defs/Action"
            }
          }
        },
        "mouse": {
          "$ref": "#/$defs/Mouse",
          "default": {
            "hide_while_typing": false,
            "scroll_multiplier": {
              "discrete": 3.0,
              "precision": 1.0
            }
          }
        },
        "theme": {
          "description": "The colour theme for the light and the dark appearance.",
          "$ref": "#/$defs/Theme",
          "default": {
            "dark": "kido-dark",
            "light": "kido-light"
          }
        },
        "window": {
          "$ref": "#/$defs/WindowSettings",
          "default": {
            "sidebar_shade": 5.0,
            "unfocused_shift": 3.0
          }
        }
      },
      "additionalProperties": false
    },
    "Argv": {
      "description": "an argv that starts with an absolute program path",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Bounds": {
      "description": "How much terminal history a pane keeps.",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "The most bytes of history.",
          "$ref": "#/$defs/Limit",
          "default": 50000000
        },
        "lines": {
          "description": "The most lines of history.",
          "$ref": "#/$defs/Limit",
          "default": "unlimited"
        }
      },
      "additionalProperties": false
    },
    "Clipboard": {
      "type": "object",
      "properties": {
        "copy_on_select": {
          "type": "boolean",
          "default": false
        },
        "paste_protection": {
          "description": "Ask before a paste that looks unsafe.",
          "type": "boolean",
          "default": true
        },
        "read": {
          "description": "Whether a program may read the clipboard (OSC 52).",
          "$ref": "#/$defs/ClipboardRead",
          "default": "ask"
        },
        "trim_trailing_spaces": {
          "type": "boolean",
          "default": true
        },
        "write": {
          "description": "Whether a program may write the clipboard (OSC 52).",
          "$ref": "#/$defs/ClipboardWrite",
          "default": "allow"
        }
      },
      "additionalProperties": false
    },
    "ClipboardRead": {
      "type": "string",
      "enum": [
        "ask",
        "allow",
        "deny"
      ]
    },
    "ClipboardWrite": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "Command": {
      "type": "object",
      "properties": {
        "prefix": {
          "description": "The argv that goes before `ko enter` in a pane's program.",
          "$ref": "#/$defs/Prefix",
          "default": []
        },
        "socket": {
          "description": "Where the runtime's socket is reached inside the runtime. Default: the host path.",
          "anyOf": [
            {
              "$ref": "#/$defs/AbsPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "up": {
          "description": "A step of the start that the server runs as its own child. Exit 0 continues the start.",
          "anyOf": [
            {
              "$ref": "#/$defs/Argv"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ConnectionArgs": {
      "description": "ssh connection options, with no destination and no command",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Container": {
      "type": "object",
      "properties": {
        "container": {
          "description": "The `container` program. Default: `container` on the PATH of the server.",
          "anyOf": [
            {
              "$ref": "#/$defs/Program"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "$ref": "#/$defs/Source"
        },
        "init": {
          "description": "The command that keeps the container alive.",
          "$ref": "#/$defs/Init",
          "default": [
            "sleep",
            "infinity"
          ]
        },
        "ko": {
          "description": "The static Linux ko beside the server's installation, the ko on PATH, or mount=DIR.",
          "$ref": "#/$defs/Ko",
          "default": "shipped"
        },
        "run_args": {
          "description": "More arguments of the engine's `run`. ko refuses the options it owns.",
          "$ref": "#/$defs/RunArgs",
          "default": []
        },
        "ssh_agent": {
          "description": "The host's agent at /var/host-services/ssh-auth.sock (`--ssh`).",
          "$ref": "#/$defs/SshAgent",
          "default": "none"
        },
        "user": {
          "description": "The user of every exec, as the engine's `exec -u` takes it. Default: the image's.",
          "anyOf": [
            {
              "$ref": "#/$defs/User"
            },
            {
              "type": "null"
            }
          ]
        },
        "volumes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Volume"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "from"
      ]
    },
    "Destination": {
      "description": "an ssh destination",
      "type": "string",
      "pattern": "^[^-\\u0000][^\\u0000]*$"
    },
    "DiscreteScroll": {
      "description": "A number of at least 0.01 and at most 100.",
      "type": "number",
      "maximum": 100.0,
      "minimum": 0.01
    },
    "Env": {
      "description": "Environment variables: names without = or NUL, values without NUL.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "Font": {
      "type": "object",
      "properties": {
        "family": {
          "description": "The font family. Absent means the system's monospaced font.",
          "anyOf": [
            {
              "$ref": "#/$defs/FontFamily"
            },
            {
              "type": "null"
            }
          ]
        },
        "features": {
          "description": "OpenType features, such as ss01 or -liga.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FontFeature"
          }
        },
        "line_height": {
          "description": "The change of the cell height in percent.",
          "$ref": "#/$defs/LineHeight",
          "default": 0.0
        },
        "size": {
          "description": "The size in points.",
          "$ref": "#/$defs/FontSize",
          "default": 13.0
        },
        "thicken": {
          "description": "Draw thicker glyphs.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "FontFamily": {
      "description": "a font family name without a newline",
      "type": "string",
      "pattern": "^[^\\r\\n]+$"
    },
    "FontFeature": {
      "description": "an OpenType feature tag with an optional + or -",
      "type": "string",
      "pattern": "^[+-]?[a-zA-Z0-9]{4}$"
    },
    "FontSize": {
      "description": "A number of at least 4 and at most 72.",
      "type": "number",
      "maximum": 72.0,
      "minimum": 4.0
    },
    "Idle": {
      "description": "Seconds, or the word none.",
      "oneOf": [
        {
          "$ref": "#/$defs/Seconds"
        },
        {
          "const": "none"
        }
      ]
    },
    "Init": {
      "description": "a command",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Keyboard": {
      "type": "object",
      "properties": {
        "option_as_alt": {
          "$ref": "#/$defs/OptionAsAlt",
          "default": "off"
        }
      },
      "additionalProperties": false
    },
    "Ko": {
      "oneOf": [
        {
          "description": "The static Linux ko beside the server's installation, mounted read-only at /opt/ko.",
          "type": "string",
          "const": "shipped"
        },
        {
          "description": "The `ko` on the PATH of the image.",
          "type": "string",
          "const": "path"
        },
        {
          "description": "Another installed layout, mounted read-only at /opt/ko.",
          "type": "object",
          "properties": {
            "mount": {
              "$ref": "#/$defs/MountDir"
            }
          },
          "additionalProperties": false,
          "required": [
            "mount"
          ]
        }
      ]
    },
    "Limit": {
      "description": "A positive integer, or the word unlimited.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "unlimited"
        }
      ]
    },
    "LineHeight": {
      "description": "A number of at least -50 and at most 100.",
      "type": "number",
      "maximum": 100.0,
      "minimum": -50.0
    },
    "MountDir": {
      "description": "an absolute path without a comma",
      "type": "string",
      "pattern": "^/[^,\\u0000]*$"
    },
    "Mouse": {
      "type": "object",
      "properties": {
        "hide_while_typing": {
          "type": "boolean",
          "default": false
        },
        "scroll_multiplier": {
          "$ref": "#/$defs/ScrollMultiplier",
          "default": {
            "discrete": 3.0,
            "precision": 1.0
          }
        }
      },
      "additionalProperties": false
    },
    "Operand": {
      "description": "an image reference or a container name",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]*$"
    },
    "OptionAsAlt": {
      "description": "Whether the option key acts as alt: off, on, or the left or right one only.",
      "type": "string",
      "enum": [
        "off",
        "on",
        "left",
        "right"
      ]
    },
    "PathMap": {
      "description": "A directory of the host and the directory of the runtime that holds the same files.",
      "type": "object",
      "properties": {
        "host": {
          "$ref": "#/$defs/AbsPath"
        },
        "runtime": {
          "$ref": "#/$defs/AbsPath"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "runtime"
      ]
    },
    "Podman": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/Source"
        },
        "init": {
          "description": "The command that keeps the container alive.",
          "$ref": "#/$defs/Init",
          "default": [
            "sleep",
            "infinity"
          ]
        },
        "ko": {
          "description": "The static Linux ko beside the server's installation, the ko on PATH, or mount=DIR.",
          "$ref": "#/$defs/Ko",
          "default": "shipped"
        },
        "podman": {
          "description": "The `podman` program. Default: `podman` on the PATH of the server.",
          "anyOf": [
            {
              "$ref": "#/$defs/Program"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_args": {
          "description": "More arguments of the engine's `run`. ko refuses the options it owns.",
          "$ref": "#/$defs/RunArgs",
          "default": []
        },
        "user": {
          "description": "The user of every exec, as the engine's `exec -u` takes it. Default: the image's.",
          "anyOf": [
            {
              "$ref": "#/$defs/User"
            },
            {
              "type": "null"
            }
          ]
        },
        "volumes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Volume"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "from"
      ]
    },
    "PrecisionScroll": {
      "description": "A number of at least 0.01 and at most 100.",
      "type": "number",
      "maximum": 100.0,
      "minimum": 0.01
    },
    "Prefix": {
      "description": "an argv",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Program": {
      "description": "a program name or path",
      "type": "string",
      "pattern": "^[^\\u0000]+$"
    },
    "RemoteDir": {
      "description": "an absolute path without a colon, a percent sign or a newline",
      "type": "string",
      "pattern": "^/[^:%\\n\\u0000]*$"
    },
    "RunArgs": {
      "description": "arguments of the container engine's `run` without an option that ko owns",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Runtime": {
      "type": "object",
      "properties": {
        "color": {
          "description": "How clients draw the runtime. Default: a colour that each client derives from the name.",
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "description": "A runtime on the host, for the tests of the link machinery. The server accepts it only\nwith KO_RUNTIME_COMMAND_KIND=1 in its environment.",
          "anyOf": [
            {
              "$ref": "#/$defs/Command"
            },
            {
              "type": "null"
            }
          ]
        },
        "container": {
          "description": "A container of Apple's `container`, which ko creates from an image or finds by name.",
          "anyOf": [
            {
              "$ref": "#/$defs/Container"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "description": "The directory inside the runtime for a pane whose request names none that maps.",
          "anyOf": [
            {
              "$ref": "#/$defs/AbsPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "env": {
          "description": "Variables for every pane of the runtime, applied before the variables of the request.",
          "$ref": "#/$defs/Env",
          "default": {}
        },
        "paths": {
          "description": "A host directory that a host caller names as cwd maps to the runtime directory of the\nlongest matching host prefix.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PathMap"
          }
        },
        "pi": {
          "description": "Where pi runs for an agent in this runtime.",
          "$ref": "#/$defs/RuntimePi",
          "default": "host"
        },
        "podman": {
          "description": "A Podman container on a Linux server.",
          "anyOf": [
            {
              "$ref": "#/$defs/Podman"
            },
            {
              "type": "null"
            }
          ]
        },
        "ssh": {
          "description": "A runtime on an ssh host, reached through one ssh master that the first pane logs in.\nko must be installed there, on the PATH of ssh commands.",
          "anyOf": [
            {
              "$ref": "#/$defs/Ssh"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "ssh": {
              "type": "object"
            }
          },
          "required": [
            "ssh"
          ]
        },
        {
          "properties": {
            "container": {
              "type": "object"
            }
          },
          "required": [
            "container"
          ]
        },
        {
          "properties": {
            "command": {
              "type": "object"
            }
          },
          "required": [
            "command"
          ]
        },
        {
          "properties": {
            "podman": {
              "type": "object"
            }
          },
          "required": [
            "podman"
          ]
        }
      ]
    },
    "RuntimeColor": {
      "description": "an #rrggbb colour",
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "RuntimePi": {
      "description": "Where an agent's pi runs when it works in a runtime.",
      "oneOf": [
        {
          "description": "On the host. Its built-in tools and `!` commands run in the runtime through exec sessions.",
          "type": "string",
          "const": "host"
        },
        {
          "description": "Inside the runtime, in a pane of the runtime.",
          "type": "string",
          "const": "runtime"
        }
      ]
    },
    "ScrollMultiplier": {
      "description": "The lines that one scroll step moves, with a trackpad (`precision`) and with a wheel\n(`discrete`).",
      "type": "object",
      "properties": {
        "discrete": {
          "$ref": "#/$defs/DiscreteScroll",
          "default": 3.0
        },
        "precision": {
          "$ref": "#/$defs/PrecisionScroll",
          "default": 1.0
        }
      },
      "additionalProperties": false
    },
    "Scrollback": {
      "description": "The word none keeps no history. A map of bytes and lines bounds it.",
      "oneOf": [
        {
          "const": "none"
        },
        {
          "$ref": "#/$defs/Bounds"
        }
      ]
    },
    "Seconds": {
      "description": "A number above 0 and at most 31536000.",
      "type": "number",
      "exclusiveMinimum": 0.0,
      "maximum": 31536000.0
    },
    "Server": {
      "description": "The server's settings. ko server reads them each time it needs one, so a change applies\nto the next pane or link.",
      "type": "object",
      "properties": {
        "kitty_images_max_bytes": {
          "description": "The most bytes of kitty graphics images that a pane keeps.",
          "type": "integer",
          "format": "uint",
          "default": 10000000,
          "minimum": 1
        },
        "linger_seconds": {
          "description": "How long a finished pane that closes on exit stays in sight, in seconds.",
          "$ref": "#/$defs/Seconds",
          "default": 30.0
        },
        "runtime_idle_seconds": {
          "description": "How long a runtime link stays up without a pane, in seconds.",
          "$ref": "#/$defs/Idle",
          "default": 600.0
        },
        "scrollback": {
          "description": "The history that a new pane keeps.",
          "$ref": "#/$defs/Scrollback",
          "default": {
            "bytes": 50000000,
            "lines": "unlimited"
          }
        },
        "shell": {
          "description": "The shell of new panes. Absent means the SHELL of the server's start, else /bin/sh.",
          "anyOf": [
            {
              "$ref": "#/$defs/AbsPath"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SidebarShade": {
      "description": "A number of at least -100 and at most 100.",
      "type": "number",
      "maximum": 100.0,
      "minimum": -100.0
    },
    "Source": {
      "oneOf": [
        {
          "description": "A container that ko creates from the image and owns: down stops it and DELETE removes it.",
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/$defs/Operand"
            }
          },
          "additionalProperties": false,
          "required": [
            "image"
          ]
        },
        {
          "description": "A container that the user created with the runtime socket shared and manages.",
          "type": "object",
          "properties": {
            "container": {
              "$ref": "#/$defs/Operand"
            }
          },
          "additionalProperties": false,
          "required": [
            "container"
          ]
        }
      ]
    },
    "Ssh": {
      "type": "object",
      "properties": {
        "destination": {
          "$ref": "#/$defs/Destination"
        },
        "dir": {
          "description": "The directory on the remote for the forwarded socket and the token files. Default:\n`$XDG_RUNTIME_DIR/ko-rt/TAG`, else `/tmp/ko-rt-UID/TAG`.\nTAG is the name, or SESSION-NAME for a runtime that ko run defines.",
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteDir"
            },
            {
              "type": "null"
            }
          ]
        },
        "ssh_args": {
          "description": "Connection options for the master (`-p`, `-J`, `-F`, `-i`, `-l`, `-o`, ...).",
          "$ref": "#/$defs/ConnectionArgs",
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "destination"
      ]
    },
    "SshAgent": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "description": "The host's agent at /var/host-services/ssh-auth.sock (`--ssh`).",
          "type": "string",
          "const": "forward"
        }
      ]
    },
    "Theme": {
      "description": "One theme name for both appearances, or a name for each.",
      "anyOf": [
        {
          "$ref": "#/$defs/ThemeName"
        },
        {
          "$ref": "#/$defs/ThemePair"
        }
      ]
    },
    "ThemeName": {
      "description": "a theme name without /, a leading dot, a comma, a colon, an equals sign or a control character",
      "type": "string",
      "pattern": "^[^/.,:=\\u0000-\\u001f\\u007f][^/,:=\\u0000-\\u001f\\u007f]*$"
    },
    "ThemePair": {
      "type": "object",
      "properties": {
        "dark": {
          "$ref": "#/$defs/ThemeName"
        },
        "light": {
          "$ref": "#/$defs/ThemeName"
        }
      },
      "additionalProperties": false,
      "required": [
        "light",
        "dark"
      ]
    },
    "UnfocusedShift": {
      "description": "A number of at least -100 and at most 100.",
      "type": "number",
      "maximum": 100.0,
      "minimum": -100.0
    },
    "User": {
      "description": "a user name or id",
      "type": "string",
      "pattern": "^[^-\\u0000][^\\u0000]*$"
    },
    "Volume": {
      "description": "A directory of the host that the container mounts, files only: never a socket.",
      "type": "object",
      "properties": {
        "host": {
          "$ref": "#/$defs/VolumePath"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/Access"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime": {
          "$ref": "#/$defs/VolumePath"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "runtime"
      ]
    },
    "VolumePath": {
      "description": "an absolute path without a colon",
      "type": "string",
      "pattern": "^/[^:\\u0000]*$"
    },
    "WindowSettings": {
      "type": "object",
      "properties": {
        "sidebar_shade": {
          "description": "The shade of the sidebar in percent. The sign follows the theme.",
          "$ref": "#/$defs/SidebarShade",
          "default": 5.0
        },
        "unfocused_shift": {
          "description": "The shift of the background of an unfocused pane in percent.",
          "$ref": "#/$defs/UnfocusedShift",
          "default": 3.0
        }
      },
      "additionalProperties": false
    }
  }
}
