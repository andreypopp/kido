{
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "kido-status.ts",
    "kido-agents.ts",
    "kido-fixture.ts",
    "kido-status-*.test.ts"
  ]
}
