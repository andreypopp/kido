(lang dune 3.21)

(pkg enabled)

(cache enabled)

(repository
 (name pin-overlays)
 (url
  "git+https://github.com/ocaml-dune/opam-overlays.git#99fc2e18c45b4761ed5f6d282910c03c97e32bce"))

(repository
 (name pin-relocatable-repo)
 (url
  "git+https://github.com/ocaml-dune/opam-repository-relocatable.git#d64df82c7e16de819a770cabf4066a06243ed80b"))

(repository
 (name pin-upstream)
 (url
  "git+https://github.com/ocaml/opam-repository.git#1ee944bdf0e542c60374c71770441e4cf6a0b5a5"))

(lock_dir
 (path dune.afl.lock)
 (repositories pin-overlays pin-relocatable-repo pin-upstream)
 (depopts ocaml-option-afl))

(context
 (default
  (name default)
  (lock_dir dune.afl.lock)))
