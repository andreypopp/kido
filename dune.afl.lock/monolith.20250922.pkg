(version 20250922)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml afl-persistent pprint)))

(source
 (fetch
  (url
   https://gitlab.inria.fr/fpottier/monolith/-/archive/20250922/archive.tar.gz)
  (checksum
   sha512=9f61a2ee01aca7cd7d0b71a20cc4a23086bbd5247a2f6b8dfe4e7c0ad242cd11bc1b418a8aa93e4a369f225a61cf2329b79ca70772d702eb97f6a6afc2212789)))
