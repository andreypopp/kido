(version 1.1.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml ppxlib yojson)))

(source
 (fetch
  (url
   https://github.com/melange-community/jsonkit/archive/refs/tags/jsonkit.1.1.0.tar.gz)
  (checksum
   sha512=ed61e57bdb75b3c56a8207491eb18ec49a6184a71bba40030c986a8d6912f455ec5acd684d5ee3e376af3625deeb5177ce65171bb9c256a4e0ec53f76e92de44)))
