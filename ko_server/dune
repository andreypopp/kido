    sh
    -c
    "root=$(git -C %{workspace_root} rev-parse --show-toplevel); revision=$(git -C \"$root\" ls-files -s third_party/ghostty | cut -d' ' -f2); test ${#revision} -eq 40 || exit 1; printf 'let value = \"%s\"\\n' \"$revision\""))))

