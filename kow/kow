            linux = Path(shutil.copytree(checkout / 'build/ko/share/ko/linux/x86_64', payload / 'linux-build', symlinks=True))
            koa = Path(shutil.copytree(checkout / 'build/koa', payload / 'koa-build', symlinks=True))
            identities = [checkout_identity(linux), checkout_identity(koa)]
        else:
            linux, koa = payload / 'linux-build', payload / 'koa-build'
            archives = [archive_source('ko', ko_version), archive_source('koa', koa_version)]
            identities = [f'release:{version}:sha256:{digest}' for version, digest, _ in archives]
        answers = installed_sources(ssh, host)
        for index, (product, source, target) in enumerate([('ko', linux, 'linux'), ('koa', koa, 'koa')]):
            (payload / (product + '-source')).write_text(identities[index] + '\n')
