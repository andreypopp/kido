def release(product, version=None):
    if version is None:
        releases = []
        for page in range(1, 101):
            with urllib.request.urlopen(REPOSITORY + f'/releases?per_page=100&page={page}', timeout=30) as response:
                batch = json.load(response)
            releases.extend(batch)
            if len(batch) < 100:
                break
        else:
            raise ValueError('release pagination exceeded 100 pages')
        versions = [r['tag_name'].removeprefix(product + '/') for r in releases
                    if not r['draft'] and not r['prerelease'] and re.fullmatch(product + r'/\d+\.\d+\.\d+', r['tag_name'])]
        version = max(versions, key=lambda v: tuple(map(int, v.split('.'))))
    if not re.fullmatch(r'\d+\.\d+\.\d+', version):
        raise ValueError('version must be major.minor.patch')
    asset_name = f'ko-{version}-linux-x86_64.tar.gz' if product == 'ko' else f'koa-{version}.tar.gz'
    with urllib.request.urlopen(REPOSITORY + f'/releases/tags/{product}/{version}', timeout=30) as response:
        data = json.load(response)
    asset = next((a for a in data['assets'] if a['name'] == asset_name), None)
    if asset is None:
        raise ValueError(f'release has no {asset_name}')
    digest = asset.get('digest') or ''
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', digest):
        raise ValueError(f'{asset_name} has no published SHA256 digest')
    return version, digest[7:], asset['browser_download_url']


def pins(check=False):
    source = Path(__file__).resolve()
    text = source.read_text()
    for product in ('ko', 'koa'):
        version, digest, _ = release(product)
        for suffix, value in [('VERSION', version), ('SHA256', digest)]:
            text = re.sub(r'^' + product.upper() + '_' + suffix + r' = .+$',
                          product.upper() + '_' + suffix + ' = ' + repr(value), text, flags=re.MULTILINE)
    if check:
        if text != source.read_text():
            raise ValueError('release pins are stale; run python3 kow/kow --pin, then commit the change before release')
    else:
        source.write_text(text)


def archive_source(product, version):
    pinned_version, pinned_digest = (KO_VERSION, KO_SHA256) if product == 'ko' else (KOA_VERSION, KOA_SHA256)
    version = version or pinned_version
    if version == pinned_version:
        asset = f'ko-{version}-linux-x86_64.tar.gz' if product == 'ko' else f'koa-{version}.tar.gz'
        digest = pinned_digest
        url = f'https://github.com/andreypopp/kido/releases/download/{product}/{version}/{asset}'
    else:
        _, digest, url = release(product, version)
    return version, digest, url


def download(product, source, destination):
    _, digest, url = source
