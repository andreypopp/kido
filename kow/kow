def installed_matches(identity, answer):
    return bool(identity) and answer == identity + '\n'


def installed_sources(ssh, host):
    try:
        result = run([*ssh, host, 'cat /opt/ko/.kow-source; cat /opt/koa.kow-source'],
                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)
        lines = result.stdout.decode().splitlines(keepends=True)
        return lines if len(lines) == 2 else ['', '']
    except (OSError, UnicodeError, subprocess.SubprocessError):
        return ['', '']


def checkout_identity(source):
    digest = hashlib.sha256()
    for path in sorted(source.rglob('*')):
        name = str(path.relative_to(source))
        if path.is_symlink():
            entry = ['link', name, os.readlink(path)]
        elif path.is_file():
            entry = ['file', name, path.stat().st_mode & 0o777, hashlib.sha256(path.read_bytes()).hexdigest()]
        else:
            entry = ['directory', name, path.stat().st_mode & 0o777]
        digest.update(json.dumps(entry).encode() + b'\n')
    return 'checkout:sha256:' + digest.hexdigest()


