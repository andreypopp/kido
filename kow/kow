            extract(root)
            run(['python3', root / 'test-provision.py', root])
        return
    if args == ['--test']:
        with tempfile.TemporaryDirectory(prefix='kow-test-') as temporary:
            root = Path(temporary)
            test_artifacts(root)
            extract(root)
            (root / 'testdata').symlink_to(CHECKOUT / 'app/Packages/KidoPairing/Tests/KidoPairingTests/testdata')
            run(['bash', root / 'test.sh'])
        return
    parser = argparse.ArgumentParser(prog='kow', usage='kow NAME {init,ssh,deploy,install,pair,unpair,list-devices,smoke} ...')
    parser.add_argument('name')
    parser.add_argument('command', choices=['init', 'ssh', 'deploy', 'install', 'pair', 'unpair', 'list-devices', 'smoke'])
    if len(args) >= 2 and args[1] in ('install', 'deploy'):
        parser.add_argument('--checkout', default=os.environ.get('KOW_CHECKOUT'))
        parser.add_argument('--ko')
        parser.add_argument('--koa')
    else:
        parser.set_defaults(checkout=None, ko=None, koa=None)
    parser.add_argument('arguments', nargs='*' if len(args) >= 2 and args[1] in ('install', 'deploy') else argparse.REMAINDER)
    options = parser.parse_args(args)
    if options.checkout and (options.ko or options.koa):
        parser.error('--checkout cannot be combined with --ko or --koa')
    folder = Path(options.name).absolute()
    if not re.fullmatch(r'[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?', folder.name):
        parser.error('NAME must be a DNS label')
    if any(c in str(folder) for c in '\n\r"\\'):
        parser.error('workspace path cannot contain quotes, backslashes or newlines')
    command, extra = options.command, options.arguments
    if command in ('init', 'deploy', 'install', 'list-devices') and extra:
        parser.error(f'{command} takes no arguments')
    if command == 'init':
        initialize(folder)
    elif command == 'deploy':
        tofu_env = {**os.environ, 'TF_WORKSPACE': 'default'}
        run(['tofu', 'init'], cwd=folder, env=tofu_env)
        run(['tofu', 'apply'], cwd=folder, env=tofu_env)
        install(folder, options.checkout, options.ko, options.koa)
    elif command == 'install':
        install(folder, options.checkout, options.ko, options.koa)
    elif command == 'smoke':
        curl = run(['curl', '-V'], stdout=subprocess.PIPE).stdout
        if b'HTTP3' not in curl.split():
            raise ValueError('smoke needs curl with HTTP/3 support; use Homebrew curl (macOS curl has no HTTP/3)')
        if len(extra) >= 2 and extra[0] == '--host':
            host, extra = extra[1], extra[2:]
        else:
            host = json.loads((folder / 'terraform.tfstate').read_text())['outputs']['ko_host']['value']
        if len(extra) > 1:
            parser.error('smoke accepts [--host HOST] [ADDRESS]')
        with tempfile.TemporaryDirectory(prefix='kow-smoke-') as temporary:
            root = Path(temporary)
            extract(root)
            run(['bash', root / 'smoke.sh', folder / 'ssh_config', host, *(extra or [address(folder)])])
    elif command == 'ssh':
        run([*ssh_command(folder), address(folder), *extra])
    else:
        remote = {'pair': 'ko-pair', 'unpair': 'ko-revoke', 'list-devices': 'ko-devices'}[command]
        if command == 'pair' and not (not extra or len(extra) == 2 and extra[0] == '--name'):
            parser.error('pair accepts only --name NAME')
        if command == 'unpair' and len(extra) != 1:
            parser.error('unpair needs a fingerprint')
        run([*ssh_command(folder), *(['-t'] if command == 'pair' else []), address(folder), shlex.join(['sudo', remote, *extra])])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f'kow: {error}', file=sys.stderr)
        sys.exit(1)
