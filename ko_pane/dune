(install
 (section bin)
 (files ko-pane))

(rule
 (targets fuzz-frame)
 (deps fuzz_frame.c protocol.h)
 (action
  (run
   cc
   -std=c11
   -g
   -O1
   -fsanitize=address,undefined
   -Wall
   -Wextra
   -Werror
   fuzz_frame.c
   -o
   fuzz-frame)))

(rule
 (alias runtest)
 (action
  (run ./fuzz-frame)))

(rule
 (targets ko-pane)
 (deps
  build.sh
  ../ko_vt/cxx.sh
  pane.c
  pixels.h
  protocol.h
  ring.h
  buffer.h
  snapshot_cut.h
  compress.h
  now.h
  ../ko_vt/libghostty-vt.a
  (source_tree ../third_party/ghostty/include))
 (action
  (run sh build.sh ko-pane pane.c -O3)))

(rule
 (targets test-pane)
 (deps
  build.sh
  ../ko_vt/cxx.sh
  test_pane.c
  pixels.h
  protocol.h
  ring.h
  ../ko_vt/libghostty-vt.a
  (source_tree ../third_party/ghostty/include))
 (action
  (run sh build.sh test-pane test_pane.c -g -O1 -fsanitize=address,undefined)))

(rule
 (targets ko-pane-asan)
 (deps
  build.sh
  ../ko_vt/cxx.sh
  pane.c
  pixels.h
  protocol.h
  ring.h
  buffer.h
  snapshot_cut.h
  compress.h
  now.h
  ../ko_vt/libghostty-vt.a
  (source_tree ../third_party/ghostty/include))
 (action
  (run sh build.sh ko-pane-asan pane.c -g -O1 -fsanitize=address,undefined)))

(rule
 (targets test-compress)
 (deps
  build.sh
  ../ko_vt/cxx.sh
  test_compress.c
  compress.h
  now.h
  ../ko_vt/libghostty-vt.a
  (source_tree ../third_party/ghostty/include))
 (action
  (run
   sh
   build.sh
   test-compress
   test_compress.c
   -g
   -O1
   -fsanitize=address,undefined)))

(rule
 (alias runtest)
 (deps test-compress)
 (action
  (run ./test-compress)))

(rule
 (alias runtest)
 (deps test-pane ko-pane-asan)
 (action
  (run ./test-pane ./ko-pane-asan)))

(rule
 (targets fuzz-frame-libfuzzer)
 (enabled_if
  (= %{profile} fuzz))
 (deps fuzz_frame.c protocol.h)
 (action
  (run
   %{env:KO_FUZZ_CC=clang}
   -std=c11
   -g
   -O1
   -DKO_LIBFUZZER
   -fsanitize=fuzzer,address,undefined
   fuzz_frame.c
   -o
   fuzz-frame-libfuzzer)))
