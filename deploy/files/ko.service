[Unit]
Description=ko server
After=network.target systemd-tmpfiles-setup.service

[Service]
User=me
Environment=KO_STATE_DIR=/var/lib/ko
Environment=PATH=/home/me/.local/bin:/opt/ko/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/ko/bin/ko server --allow-uid @CADDY_UID@
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
