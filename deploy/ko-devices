#!/usr/bin/python3
import base64
import binascii
import fcntl
import hashlib
import hmac
import http.server
import json
import os
from pathlib import Path
import re
import secrets
import signal
import socket
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager

from cryptography import x509
from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import ec
from cryptography.x509.oid import ExtendedKeyUsageOID, SignatureAlgorithmOID

DIRECTORY = Path(os.environ.get("KO_DEVICES_DIR", "/var/lib/ko-devices"))


@contextmanager
def locked():
    fd = os.open(DIRECTORY, os.O_RDONLY | os.O_DIRECTORY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield fd
    finally:
        os.close(fd)


def atomic(name, data):
    fd, temporary = tempfile.mkstemp(prefix=".device-", dir=DIRECTORY)
    try:
        with os.fdopen(fd, "wb") as stream:
            os.fchmod(stream.fileno(), 0o640)
            os.fchown(stream.fileno(), DIRECTORY.stat().st_uid, DIRECTORY.stat().st_gid)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, DIRECTORY / name)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def restart():
    override = os.environ.get("KO_PAIR_RESTART")
    if override is not None:
        subprocess.run(override, shell=True, check=True, timeout=10)
        return
    subprocess.run(["systemctl", "restart", "caddy"], check=True, timeout=10)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        active = subprocess.run(["systemctl", "is-active", "--quiet", "caddy"], timeout=1).returncode == 0
        if active:
            try:
                with socket.create_connection(("127.0.0.1", 443), timeout=0.2):
                    return
            except OSError:
                pass
        time.sleep(0.1)
    raise RuntimeError("Caddy did not become ready within 10 seconds; device files stay as written")


def decode(value, limit):
    if not isinstance(value, str) or len(value) > limit * 2:
        raise ValueError("invalid encoding")
    result = base64.b64decode(value, validate=True)
    if len(result) > limit:
        raise ValueError("value too large")
    return result


def certificate(der):
    cert = x509.load_der_x509_certificate(der)
    if cert.public_bytes(serialization.Encoding.DER) != der:
        raise ValueError("not one DER certificate")
    key = cert.public_key()
    if not isinstance(key, ec.EllipticCurvePublicKey) or not isinstance(key.curve, ec.SECP256R1):
        raise ValueError("not P-256")
    if cert.issuer != cert.subject or cert.signature_algorithm_oid != SignatureAlgorithmOID.ECDSA_WITH_SHA256:
        raise ValueError("not self-signed with SHA-256")
    key.verify(cert.signature, cert.tbs_certificate_bytes, ec.ECDSA(hashes.SHA256()))
    if cert.extensions.get_extension_for_class(x509.BasicConstraints).value.ca:
        raise ValueError("CA certificate")
    if ExtendedKeyUsageOID.CLIENT_AUTH not in cert.extensions.get_extension_for_class(x509.ExtendedKeyUsage).value:
        raise ValueError("no clientAuth")
    return cert, key


def pair(host, enroll, port):
    seconds = float(os.environ.get("KO_PAIR_SECONDS", "120"))
    if not 0 < seconds <= 120:
        raise ValueError("KO_PAIR_SECONDS must be greater than zero and at most 120")
    token = secrets.token_bytes(32)
    token_hash = hashlib.sha256(token).digest()
    payload = {"v": 1, "enroll": f"https://{enroll}/v1/enroll", "host": host,
               "token": base64.urlsafe_b64encode(token).decode().rstrip("=")}
    text = "kido-pair: " + json.dumps(payload, separators=(",", ":"))
    deadline = time.monotonic() + seconds
    done = False
    paired = None
    wrong = 0
    requests = 0

    class Handler(http.server.BaseHTTPRequestHandler):
        def setup(self):
            super().setup()
            limit = min(5, max(0.001, deadline - time.monotonic()))
            self.connection.settimeout(limit)
            signal.setitimer(signal.ITIMER_REAL, limit)

        def finish(self):
            signal.setitimer(signal.ITIMER_REAL, 0)
            super().finish()

        def log_message(self, *_):
            pass

        def handle_one_request(self):
            nonlocal requests, done
            requests += 1
            self.result, self.fingerprint = 400, "-"
            try:
                super().handle_one_request()
            finally:
                done = done or requests >= 30
                headers = getattr(self, "headers", {})
                forwarded = json.dumps(headers.get("X-Forwarded-For", "-"), ensure_ascii=True)
                print(f"result={self.result} fingerprint={self.fingerprint} forwarded={forwarded}", file=sys.stderr, flush=True)

        def __getattr__(self, name):
            if name.startswith("do_"):
                return self.do_POST
            raise AttributeError(name)

        def do_POST(self):
            nonlocal done, paired, wrong
            status, fingerprint = 400, "-"
            try:
                if time.monotonic() >= deadline:
                    status = 403
                    done = True
                elif requests >= 30:
                    status = 429
                    done = True
                elif self.command != "POST" or self.path != "/v1/enroll":
                    status = 400
                else:
                    lengths = self.headers.get_all("Content-Length", [])
                    if len(lengths) != 1 or not re.fullmatch(r"[0-9]{1,8}", lengths[0]) or self.headers.get("Transfer-Encoding"):
                        raise ValueError("invalid length")
                    length = int(lengths[0])
                    if not 0 < length <= 8192:
                        raise ValueError("body too large")
                    body = self.rfile.read(length)
                    if len(body) != length:
                        raise ValueError("short body")
                    data = json.loads(body)
                    if not isinstance(data, dict) or set(data) != {"token", "name", "certificate", "signature"}:
                        raise ValueError("invalid shape")
                    name = data["name"]
                    if not isinstance(name, str) or not 1 <= len(name) <= 64 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in name):
                        raise ValueError("invalid name")
                    supplied = data["token"]
                    if not isinstance(supplied, str) or not re.fullmatch(r"[A-Za-z0-9_-]{43}", supplied):
                        raise ValueError("invalid token encoding")
                    if not isinstance(data["certificate"], str) or not isinstance(data["signature"], str):
                        raise ValueError("invalid shape")
                    raw_token = base64.urlsafe_b64decode(supplied + "=")
                    if not hmac.compare_digest(hashlib.sha256(raw_token).digest(), token_hash):
                        wrong += 1
                        status = 403
                        done = wrong >= 5
                    else:
                        done = True
                        signal.setitimer(signal.ITIMER_REAL, 0)
                        der = decode(data["certificate"], 2048)
                        cert, key = certificate(der)
                        fingerprint = hashlib.sha256(der).hexdigest()
                        signature = decode(data["signature"], 128)
                        key.verify(signature, b"kido-enroll-v1\x00" + token_hash + hashlib.sha256(der).digest(), ec.ECDSA(hashes.SHA256()))
                        with locked() as fd:
                            pem = DIRECTORY / (fingerprint + ".pem")
                            if pem.exists():
                                raise ValueError("device already exists")
                            try:
                                atomic(fingerprint + ".json", json.dumps({"name": name, "enrolled": int(time.time())}).encode())
                                atomic(fingerprint + ".pem", cert.public_bytes(serialization.Encoding.PEM))
                                os.fsync(fd)
                                result = subprocess.run(["caddy", "validate", "--config", "/etc/caddy/Caddyfile"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
                                if result.returncode:
                                    raise ValueError("Caddy validation failed")
                            except (OSError, ValueError, subprocess.SubprocessError):
                                pem.unlink(missing_ok=True)
                                (DIRECTORY / (fingerprint + ".json")).unlink(missing_ok=True)
                                os.fsync(fd)
                                raise
                        paired = (name, fingerprint)
                        status = 200
            except (ValueError, TypeError, KeyError, RecursionError, InvalidSignature, x509.ExtensionNotFound, binascii.Error, OSError, subprocess.SubprocessError):
                status = 400
            signal.setitimer(signal.ITIMER_REAL, 0)
            answer = json.dumps({"fingerprint": fingerprint} if status == 200 else {}).encode()
            try:
                self.send_response(status)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(answer)))
                self.send_header("Connection", "close")
                self.end_headers()
                self.wfile.write(answer)
                self.wfile.flush()
            except OSError:
                pass
            self.result, self.fingerprint = status, fingerprint

    def timed_out(*_):
        raise TimeoutError("request deadline")

    signal.signal(signal.SIGALRM, timed_out)
    with http.server.HTTPServer(("127.0.0.1", port), Handler) as server:
        print(text, flush=True)
        subprocess.run(["qrencode", "-t", "ansiutf8"], input=text.encode(), check=True, timeout=seconds)
        del token, payload, text
        while not done and time.monotonic() < deadline:
            server.timeout = min(0.2, max(0.001, deadline - time.monotonic()))
            server.handle_request()
    if paired:
        try:
            restart()
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            raise RuntimeError(f"Caddy activation failed; device {paired[1]} stays installed: {error}") from error
        print(f"paired {paired[0]} {paired[1]}", flush=True)
        return 0
    print("no device paired", file=sys.stderr)
    return 1


def main():
    if os.geteuid() != 0:
        raise ValueError("run as root")
    command = Path(sys.argv[0]).name
    if command == "ko-pair" and len(sys.argv) in (1, 4):
        if len(sys.argv) == 1:
            settings = json.loads(Path("/etc/ko-pair.json").read_text())
            names = [settings["host"], settings["enroll"]]
            port = settings["port"]
        else:
            names = sys.argv[1:3]
            port = int(sys.argv[3])
        if not isinstance(port, int) or not 1 <= port <= 65535:
            raise ValueError("invalid port")
        for name in names:
            if len(name) > 253 or not re.fullmatch(r"[a-z0-9][a-z0-9.-]*[a-z0-9]", name):
                raise ValueError("invalid host name")
        return pair(*names, port)
    if command == "ko-revoke" and len(sys.argv) == 2:
        prefix = sys.argv[1]
        if not re.fullmatch(r"[0-9a-f]{8,64}", prefix):
            raise ValueError("use a lowercase fingerprint or at least 8 hex digits")
        with locked() as fd:
            matches = list(DIRECTORY.glob(prefix + "*.pem"))
            if len(matches) != 1:
                raise ValueError("fingerprint is absent or ambiguous")
            pem = matches[0]
            pem.unlink()
            pem.with_suffix(".json").unlink(missing_ok=True)
            os.fsync(fd)
            try:
                restart()
            except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                raise RuntimeError(f"Caddy activation failed; device {pem.stem} stays removed: {error}") from error
        print(f"revoked {pem.stem}")
        return 0
    if command == "ko-devices" and len(sys.argv) == 1:
        with locked():
            for pem in sorted(DIRECTORY.glob("*.pem")):
                data = json.loads(pem.with_suffix(".json").read_text())
                print(f"{data['name']}\t{pem.stem}\t{data['enrolled']}")
        return 0
    raise ValueError("usage: ko-pair [HOST ENROLL PORT] | ko-revoke FP | ko-devices")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"{Path(sys.argv[0]).name}: {error}", file=sys.stderr)
        sys.exit(1)
